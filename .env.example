TRANSCRIBER_COMMAND=python3
TRANSCRIBER_ARGS=scripts/vosk_transcribe.py --model /opt/vosk-model --input {input} --output {output} {diarizeArgs} {diarizationModelArgs}
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# HUGGINGFACE_TOKEN=hf_...
# Filtrage audio avant Vosk. Laisser vide pour desactiver.
FFMPEG_AUDIO_FILTERS=highpass=f=80,lowpass=f=7800,loudnorm
# MAX_UPLOAD_BODY_MB=512

# Parametres PostgreSQL du conteneur CRM local.
POSTGRES_DB=transcription_crm
POSTGRES_USER=transcription_user
POSTGRES_PASSWORD=transcription_password
POSTGRES_HOST=postgres-crm
POSTGRES_PORT=5432

# Webhook n8n appele uniquement par l API pour les messages de l interface Web.
N8N_AGENT_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/agent-chat
N8N_RECENT_CLIENTS_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/clients-recents
N8N_MISSING_DOCUMENTS_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/documents-manquants
N8N_PORTFOLIO_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/portefeuille
N8N_CLIENT_DOSSIER_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/dossier-client
N8N_DOSSIER_WRITE_WEBHOOK_URL=http://host.docker.internal:5678/webhook/crm/enregistrer-dossier
AGENT_TIMEOUT_MS=120000

# Identité OIDC locale. Choisir un mot de passe administrateur hors dépôt.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin-local
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=remplacer-par-un-secret-local
# Pour un test externe via Cloudflare Tunnel :
# KEYCLOAK_ISSUER=https://auth-test.example.com/realms/crm-local
# KEYCLOAK_PUBLIC_URL=https://auth-test.example.com
KEYCLOAK_ISSUER=http://localhost:8080/realms/crm-local
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/crm-local/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=crm-api
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=crm-local
KEYCLOAK_CLIENT_ID=crm-web
# Générés par scripts/configurer_service_admin_keycloak.ps1. Ne jamais les exposer au Web.
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=remplacer-par-le-secret-du-compte-technique
