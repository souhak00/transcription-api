{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tonia — demande de synthèse et courriel (Android 0.9)",
  "description": "POST /api/mobile/jobs. Textes uniquement, aucune fiche client ni audio. Le serveur recalcule et compare sourceHash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "noteId", "revision", "status", "sendConfirmed", "title", "transcript", "personalNotes", "association", "delivery"],
  "properties": {
    "kind": {"const": "SUMMARY_EMAIL"},
    "noteId": {"type": "string", "pattern": "^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "FINALIZED"},
    "sendConfirmed": {"const": true},
    "testDeliveryConfirmed": {"const": true, "description": "Requis uniquement en mode serveur MAILPIT (Android 0.9.2+); refusé en mode LIVE. Le mode effectif est fixé par le serveur, jamais par ce champ."},
    "title": {"type": "string", "maxLength": 200},
    "transcript": {"type": "string", "minLength": 1, "maxLength": 500000},
    "personalNotes": {"type": "string", "maxLength": 50000},
    "association": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["state"],
          "properties": {"state": {"const": "UNASSIGNED"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["state", "clientCode"],
          "properties": {
            "state": {"const": "ASSIGNED"},
            "clientCode": {"type": "string", "pattern": "^CLI-[0-9]{4}-[A-Z]{2}-[0-9]{6}$"}
          }
        }
      ]
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceHash", "recipientEmail", "recipientConfirmed"],
      "properties": {
        "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "recipientEmail": {"type": "string", "format": "email", "maxLength": 254},
        "recipientConfirmed": {"const": true}
      }
    }
  }
}
