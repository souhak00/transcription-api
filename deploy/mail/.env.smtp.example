# Copier vers .env.smtp sur le VPS; ne jamais versionner ce fichier d'exploitation.
# Garder blocked jusqu'à validation A/PTR/SPF/DKIM/DMARC et recette autorisée.
TONIA_MAIL_RELEASE=blocked
TONIA_MAIL_FROM=administration@toniaconseil.com
TONIA_MAIL_DOMAIN=toniaconseil.com
TONIA_MAIL_HOSTNAME=mail.toniaconseil.com
# Adresse IPv4 publique du VPS, utilisée seulement par le contrôle DNS préalable.
TONIA_MAIL_PUBLIC_IPV4=REMPLACER_PAR_IPV4_DU_VPS
