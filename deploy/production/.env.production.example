# Domaines publics et certificats TLS
CRM_DOMAIN=crm.toniaconseil.com
AUTH_DOMAIN=auth.toniaconseil.com
N8N_DOMAIN=n8n.toniaconseil.com
ACME_EMAIL=administration@toniaconseil.com
TZ=America/Toronto

# PostgreSQL CRM : générer trois secrets différents et robustes.
POSTGRES_DB=transcription_crm
POSTGRES_USER=transcription_admin
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
KEYCLOAK_DB_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE
CRM_RUNTIME_PASSWORD=REMPLACER_PAR_UN_TROISIEME_SECRET_ALEATOIRE

# Keycloak
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin-crm
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=REMPLACER_PAR_UN_SECRET_ALEATOIRE
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin-api
KEYCLOAK_ADMIN_CLIENT_SECRET=REMPLACER_PAR_LE_SECRET_MIGRE_DE_KEYCLOAK
# Pour migrer les utilisateurs existants sur le VPS :
# KEYCLOAK_REALM_IMPORT_PATH=./runtime/migration/keycloak-realm-production.json
KEYCLOAK_REALM_IMPORT_PATH=../../keycloak/realm-crm-production.json

# Protection additionnelle de l’interface d’administration n8n.
N8N_PROXY_USER=administrateur
# Générer avec : docker run --rm caddy:2.10.2-alpine caddy hash-password
# Si le hash commence par $, entourer toute la valeur de guillemets simples.
N8N_PROXY_PASSWORD_HASH=REMPLACER_PAR_UN_HASH_BCRYPT_CADDY

# Facultatif : seulement si la diarisation pyannote est activée.
HUGGINGFACE_TOKEN=

# Modèle téléchargé dans Ollama après le premier démarrage.
OLLAMA_MODEL=mistral-nemo
