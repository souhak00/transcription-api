{
  "clientId": "crm-mobile",
  "name": "Tonia mobile – connexion native",
  "enabled": true,
  "protocol": "openid-connect",
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "redirectUris": [
    "com.toniaconseil.voicenotes:/oauth2redirect"
  ],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "600"
  },
  "defaultClientScopes": [
    "basic",
    "web-origins",
    "acr",
    "roles",
    "profile",
    "email"
  ],
  "protocolMappers": [
    {
      "name": "representant_id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "representant_id",
        "claim.name": "representant_id",
        "jsonType.label": "String",
        "id.token.claim": "true",
        "access.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "crm-api-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "crm-api",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    }
  ]
}
