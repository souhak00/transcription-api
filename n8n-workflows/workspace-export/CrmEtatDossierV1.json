      "id": "f1016d4f-2b4a-4fc9-9dbd-50b1f7b4d002",
      "name": "Définir recherche client",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -620,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH contexte AS MATERIALIZED (\n  SELECT\n    set_config('app.role', 'representant', true),\n    set_config('app.representant_id', $1::text, true)\n)\nSELECT crm.rechercher_clients($2::text) AS resultat\nFROM contexte;",
        "options": {
          "queryReplacement": "={{ [$json.representant_id, $json.terme_recherche] }}"
        }
      },
      "id": "f1016d4f-2b4a-4fc9-9dbd-50b1f7b4d003",
      "name": "CRM - Rechercher clients",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -380,
        0
      ],
      "notesInFlow": true,
      "notes": "Workflow manuel de validation. Le nœud appelle uniquement le service crm.rechercher_clients().",
      "credentials": {
        "postgres": {
          "id": "4ck3F2rmlyoKa4hx",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const resultat = $json.resultat;\nconst candidats = resultat?.resultats ?? [];\nconst exacts = candidats.filter((client) =>\n  client.nom_client?.localeCompare('Tremblay', 'fr', { sensitivity: 'accent' }) === 0\n);\n\nif (exacts.length !== 1) {\n  throw new Error(`Sélection de validation impossible: ${exacts.length} correspondance(s) exacte(s) parmi ${candidats.length} résultat(s).`);\n}\n\nreturn [{ json: { client_id: exacts[0].client_id, client: exacts[0], nombre_candidats: candidats.length } }];"
      },
      "id": "f1016d4f-2b4a-4fc9-9dbd-50b1f7b4d004",
      "name": "Sélectionner client",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ],
      "notesInFlow": true,
      "notes": "Sélection déterministe réservée au scénario de validation Tremblay. L'agent conversationnel devra demander une clarification en cas d'ambiguïté."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH contexte AS MATERIALIZED (\n  SELECT\n    set_config('app.role', 'representant', true),\n    set_config('app.representant_id', $1::text, true)\n)\nSELECT crm.obtenir_etat_dossier($2::uuid) AS resultat\nFROM contexte;",
        "options": {
          "queryReplacement": "={{ [$('Définir recherche client').first().json.representant_id, $json.client_id] }}"
        }
      },
      "id": "f1016d4f-2b4a-4fc9-9dbd-50b1f7b4d005",
      "name": "CRM - Obtenir état du dossier",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        100,
        0
      ],
      "notesInFlow": true,
      "notes": "Workflow manuel de validation. Aucun accès direct aux tables.",
      "credentials": {
        "postgres": {
          "id": "4ck3F2rmlyoKa4hx",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c85ee4c8-e425-48bf-bf20-2e03f01a9a10",
              "name": "etat_dossier",
              "value": "={{ $json.resultat }}",
              "type": "object"
            },
            {
              "id": "eb7ed69d-f826-474e-a1ba-68292632c60f",
              "name": "prompt",
              "value": "=Tu es un assistant CRM hypothécaire québécois. Résume uniquement les faits du JSON suivant en français clair, en 120 mots maximum. Mentionne l'état, les documents manquants, les tâches ouvertes et la prochaine action. Ne mentionne jamais les UUID, les identifiants techniques ni les champs internes. N'invente rien. Termine toujours par une phrase complète.\\n\\n{{ JSON.stringify($json.resultat) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f1016d4f-2b4a-4fc9-9dbd-50b1f7b4d006",
      "name": "Préparer contexte IA",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        340,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'mistral-nemo', prompt: $json.prompt, stream: false, options: { temperature: 0, num_predict: 500 } }) }}",
        "options": {
